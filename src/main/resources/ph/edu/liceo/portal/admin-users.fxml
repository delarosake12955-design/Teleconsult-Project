<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.liceo.portal.controller.AdminUsersController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="main-scroll"
            stylesheets="@admin-users.css, @teleconsult-theme.css">
    <content>
        <VBox spacing="24" styleClass="main-content">

            <VBox spacing="7">
                <Label text="Manage Users" styleClass="page-title"/>
                <Label text="Search, activate, deactivate or remove accounts across TeleConsult."
                       styleClass="page-description"/>
            </VBox>

            <HBox spacing="16">
                <VBox HBox.hgrow="ALWAYS" spacing="5" styleClass="summary-card">
                    <Label text="Total Users" styleClass="summary-title"/>
                    <Label fx:id="totalUsersLabel" text="0" styleClass="summary-number"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5" styleClass="summary-card">
                    <Label text="Active Accounts" styleClass="summary-title"/>
                    <Label fx:id="activeUsersLabel" text="0" styleClass="summary-number"/>
                </VBox>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="search-card">
                <TextField fx:id="searchField"
                           promptText="Search by name, email, patient ID or license"
                           HBox.hgrow="ALWAYS"
                           styleClass="search-field"/>
                <ComboBox fx:id="roleFilterComboBox"
                          promptText="Role"
                          styleClass="filter-combo-box"/>
                <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
                <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
            </HBox>

            <VBox spacing="14" styleClass="table-card">
                <Label text="User Accounts" styleClass="section-title"/>

                <TableView fx:id="userTable" prefHeight="380" styleClass="record-table">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="190"/>
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="110"/>
                        <TableColumn fx:id="licenseColumn" text="License No." prefWidth="140"/>
                        <TableColumn fx:id="roleColumn" text="Role" prefWidth="110"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="No users match your search." styleClass="empty-label"/>
                    </placeholder>
                </TableView>

                <Label fx:id="messageLabel" text="" wrapText="true" styleClass="message"/>

                <HBox spacing="12">
                    <Button text="Activate" onAction="#handleActivate" styleClass="primary-button"/>
                    <Button text="Deactivate" onAction="#handleDeactivate" styleClass="secondary-button"/>
                    <Button text="Delete" onAction="#handleDelete" styleClass="danger-button"/>
                </HBox>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
