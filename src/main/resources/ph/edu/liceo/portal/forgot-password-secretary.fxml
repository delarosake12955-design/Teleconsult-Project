<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Secretary forgot-password page. Same controller for all four roles; the role comes from
     the reset button's userData. Palette: login-secretary.css, extras: forgot-secretary.css. -->
<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.liceo.portal.controller.ForgotPasswordController"
            stylesheets="@login-theme.css, @login-secretary.css, @forgot-theme.css, @forgot-secretary.css"
            styleClass="login-page,login-secretary">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header">
            <padding>
                <Insets top="22" right="50" bottom="14" left="50"/>
            </padding>

            <ImageView fitWidth="50" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@register-logo.png"/>
                </image>
            </ImageView>

            <VBox spacing="1">
                <HBox alignment="BOTTOM_LEFT">
                    <Label text="Tele" styleClass="logo-tele"/>
                    <Label text="Consult" styleClass="logo-consult"/>
                </HBox>
                <Label text="M E D I C A L   S Y S T E M" styleClass="logo-subtitle"/>
            </VBox>

            <Label text="SECRETARY PASSWORD RESET" styleClass="role-badge"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="←  Back to Login"
                    fx:id="backButton"
                    onAction="#handleBack"
                    styleClass="back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="login-scroll">
            <content>
                <StackPane styleClass="main-container">
                    <padding>
                        <Insets top="6" right="40" bottom="14" left="40"/>
                    </padding>

                    <HBox alignment="CENTER"
                          maxWidth="980"
                          maxHeight="Infinity"
                          styleClass="login-split">

                        <!-- ===== role panel ===== -->
                        <StackPane minWidth="370" prefWidth="370" maxWidth="370" styleClass="hero-panel">

                            <Region styleClass="hero-orb-big" StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
                            <Region styleClass="hero-orb-small" StackPane.alignment="BOTTOM_LEFT" mouseTransparent="true"/>

                            <VBox alignment="TOP_LEFT" spacing="14" styleClass="hero-content">

                                <Label text="SECRETARY  PORTAL" styleClass="hero-chip"/>

                                <StackPane styleClass="hero-art" alignment="CENTER">
                                    <ImageView fitWidth="240" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@register-secretary.png"/>
                                        </image>
                                    </ImageView>
                                </StackPane>

                                <Label text="Back to the front&#10;desk in a minute." wrapText="true" styleClass="hero-title"/>
                                <Label text="Verify your account with your registered department, then set a new password." wrapText="true" styleClass="hero-sub"/>

                                <VBox spacing="10" styleClass="feature-list">
                                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="feature-row">
                                    <StackPane styleClass="step-num">
                                        <Label text="1" styleClass="step-num-text"/>
                                    </StackPane>
                                    <VBox spacing="1">
                                        <Label text="Confirm your identity" styleClass="feature-title"/>
                                        <Label text="Email, full name and department." wrapText="true" styleClass="feature-desc"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="feature-row">
                                    <StackPane styleClass="step-num">
                                        <Label text="2" styleClass="step-num-text"/>
                                    </StackPane>
                                    <VBox spacing="1">
                                        <Label text="Choose a new password" styleClass="feature-title"/>
                                        <Label text="A strong password protects the clinic." wrapText="true" styleClass="feature-desc"/>
                                    </VBox>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="feature-row">
                                    <StackPane styleClass="step-num">
                                        <Label text="3" styleClass="step-num-text"/>
                                    </StackPane>
                                    <VBox spacing="1">
                                        <Label text="Back to scheduling" styleClass="feature-title"/>
                                        <Label text="Sign in and keep appointments moving." wrapText="true" styleClass="feature-desc"/>
                                    </VBox>
                                </HBox>
                                </VBox>

                            </VBox>
                        </StackPane>

                        <!-- ===== reset form ===== -->
                        <VBox alignment="CENTER_LEFT"
                              spacing="13"
                              HBox.hgrow="ALWAYS"
                              minWidth="440"
                              styleClass="form-panel">

                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane styleClass="reset-icon">
                                    <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2zm-6 9a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" styleClass="reset-glyph"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="R E S E T   P A S S W O R D" styleClass="eyebrow"/>
                                    <Label text="Forgot your password?" styleClass="title"/>
                                </VBox>
                            </HBox>

                            <Label text="Confirm who you are, then choose a new secretary password."
                                   wrapText="true"
                                   styleClass="subtitle"/>

                            <HBox spacing="14">
                                <VBox spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Email" styleClass="field-label"/>
                                    <TextField fx:id="emailField"
                                               promptText="Enter your email"
                                               onAction="#handleEmailEnter"
                                               styleClass="login-input"/>
                                </VBox>

                                <VBox spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Full Name" styleClass="field-label"/>
                                    <TextField fx:id="fullNameField"
                                               promptText="Name as registered"
                                               onAction="#handleNameEnter"
                                               styleClass="login-input"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="7">
                                <Label text="Department" styleClass="field-label"/>
                                <TextField fx:id="detailField"
                                           promptText="Enter your department"
                                           onAction="#handleDetailEnter"
                                           styleClass="login-input"/>
                            </VBox>

                            <HBox spacing="14">
                                <VBox spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="New Password" styleClass="field-label"/>
                                    <PasswordField fx:id="newPasswordField"
                                                   promptText="New password"
                                                   onAction="#handleNewEnter"
                                                   styleClass="login-input"/>
                                    <TextField fx:id="newVisibleField"
                                               promptText="New password"
                                               visible="false"
                                               managed="false"
                                               onAction="#handleNewEnter"
                                               styleClass="login-input"/>
                                </VBox>

                                <VBox spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Confirm Password" styleClass="field-label"/>
                                    <PasswordField fx:id="confirmPasswordField"
                                                   promptText="Re-enter password"
                                                   onAction="#handleReset"
                                                   styleClass="login-input"/>
                                    <TextField fx:id="confirmVisibleField"
                                               promptText="Re-enter password"
                                               visible="false"
                                               managed="false"
                                               onAction="#handleReset"
                                               styleClass="login-input"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <CheckBox fx:id="showPasswordCheckBox"
                                          text="Show password"
                                          onAction="#handleShowPassword"
                                          styleClass="show-password"/>
                            </HBox>

                            <Label text="8+ characters with uppercase, lowercase, number and special character."
                                   wrapText="true"
                                   styleClass="field-hint"/>

                            <Label fx:id="messageLabel"
                                   text=""
                                   wrapText="true"
                                   styleClass="message"/>

                            <Button text="Reset Password  →"
                                    fx:id="resetButton"
                                    userData="Secretary"
                                    onAction="#handleReset"
                                    maxWidth="Infinity"
                                    styleClass="login-submit"/>

                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="Remembered it?" styleClass="small-text"/>
                                <Button text="Sign in as Secretary"
                                        fx:id="signInButton"
                                        onAction="#handleBack"
                                        styleClass="link-button"/>
                            </HBox>

                        </VBox>
                    </HBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="6" styleClass="footer">
            <padding>
                <Insets top="8" right="20" bottom="14" left="20"/>
            </padding>

            <HBox alignment="CENTER" spacing="14">
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
                <SVGPath content="M0 14 L16 14 L22 14 L27 3 L35 26 L41 14 L62 14" styleClass="ecg"/>
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
            </HBox>

            <Label text="TeleConsult Medical System  •  Secretary Portal" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>
