<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.liceo.portal.controller.ForgotPasswordController"
            stylesheets="@login.css, @register-theme.css, @date-picker-theme.css"
            styleClass="page,reg-page,reg-login">

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="header">

            <padding>
                <Insets top="22"
                        right="50"
                        bottom="22"
                        left="50"/>
            </padding>

            <ImageView fitWidth="46" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@register-logo.png"/>
                </image>
            </ImageView>

            <VBox spacing="1">

                <HBox alignment="BOTTOM_LEFT">
                    <Label text="Tele" styleClass="logo-tele"/>
                    <Label text="Consult" styleClass="logo-consult"/>
                </HBox>

                <Label text="M E D I C A L   S Y S T E M"
                       styleClass="logo-subtitle"/>

            </VBox>

            <Label text="RESET PASSWORD"
                   styleClass="login-badge"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="←  Back to Login"
                    fx:id="backButton"
                    onAction="#handleBack"
                    styleClass="back-button"/>

        </HBox>

    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="registration-scroll">

            <content>

                <StackPane styleClass="main-container">

                    <StackPane styleClass="glass-layer-one"/>
                    <StackPane styleClass="glass-layer-two"/>
                    <StackPane styleClass="glass-layer-three"/>

                    <VBox alignment="CENTER"
                          spacing="16"
                          maxWidth="520"
                          styleClass="login-card">

                        <VBox alignment="CENTER"
                              spacing="6">

                            <StackPane styleClass="login-icon">

                                <Label text="?"
                                       styleClass="login-icon-text"/>

                            </StackPane>

                            <Label text="Forgot your password?"
                                   styleClass="title"/>

                            <Label text="Confirm who you are, then choose a new password."
                                   styleClass="subtitle"/>

                        </VBox>

                        <VBox spacing="7">

                            <Label text="I am a"
                                   styleClass="field-label"/>

                            <HBox spacing="8"
                                  alignment="CENTER">

                                <Button text="Patient"
                                        fx:id="patientButton"
                                        onAction="#selectPatient"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="role-button"/>

                                <Button text="Doctor"
                                        fx:id="doctorButton"
                                        onAction="#selectDoctor"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="role-button"/>

                                <Button text="Nurse"
                                        fx:id="nurseButton"
                                        onAction="#selectNurse"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="role-button"/>

                                <Button text="Secretary"
                                        fx:id="secretaryButton"
                                        onAction="#selectSecretary"
                                        maxWidth="Infinity"
                                        HBox.hgrow="ALWAYS"
                                        styleClass="role-button"/>

                            </HBox>

                        </VBox>

                        <VBox spacing="7">

                            <Label text="Email"
                                   styleClass="field-label"/>

                            <TextField fx:id="emailField"
                                       promptText="Enter your email"
                                       onAction="#handleEmailEnter"
                                       styleClass="text-field"/>

                        </VBox>

                        <VBox spacing="7">

                            <Label text="Full Name"
                                   styleClass="field-label"/>

                            <TextField fx:id="fullNameField"
                                       promptText="Enter your full name as registered"
                                       onAction="#handleNameEnter"
                                       styleClass="text-field"/>

                        </VBox>

                        <VBox spacing="7">

                            <Label fx:id="detailLabel"
                                   text="Date of Birth"
                                   styleClass="field-label"/>

                            <DatePicker fx:id="dobPicker"
                                        promptText="MM/DD/YYYY  or pick from the calendar"
                                        maxWidth="Infinity"
                                        onAction="#handleDetailEnter"
                                        styleClass="date-picker"/>

                            <TextField fx:id="detailField"
                                       promptText="Enter your license number"
                                       visible="false"
                                       managed="false"
                                       onAction="#handleDetailEnter"
                                       styleClass="text-field"/>

                        </VBox>

                        <VBox spacing="7">

                            <Label text="New Password"
                                   styleClass="field-label"/>

                            <PasswordField fx:id="newPasswordField"
                                           promptText="Enter a new password"
                                           onAction="#handleNewEnter"
                                           styleClass="text-field"/>

                            <TextField fx:id="newVisibleField"
                                       promptText="Enter a new password"
                                       visible="false"
                                       managed="false"
                                       onAction="#handleNewEnter"
                                       styleClass="text-field"/>

                            <Label text="8+ characters with uppercase, lowercase, number and special character."
                                   styleClass="field-hint"/>

                        </VBox>

                        <VBox spacing="7">

                            <Label text="Confirm New Password"
                                   styleClass="field-label"/>

                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Re-enter the new password"
                                           onAction="#handleReset"
                                           styleClass="text-field"/>

                            <TextField fx:id="confirmVisibleField"
                                       promptText="Re-enter the new password"
                                       visible="false"
                                       managed="false"
                                       onAction="#handleReset"
                                       styleClass="text-field"/>

                            <CheckBox fx:id="showPasswordCheckBox"
                                      text="Show password"
                                      onAction="#handleShowPassword"
                                      styleClass="show-password"/>

                        </VBox>

                        <Label fx:id="messageLabel"
                               text=""
                               wrapText="true"
                               styleClass="message"/>

                        <Button text="Reset Password  →"
                                fx:id="resetButton"
                                onAction="#handleReset"
                                maxWidth="Infinity"
                                styleClass="login-main-button"/>

                        <HBox alignment="CENTER"
                              spacing="5">

                            <Label text="Remembered it?"
                                   styleClass="small-text"/>

                            <Button text="Sign in"
                                    fx:id="signInButton"
                                    onAction="#handleBack"
                                    styleClass="link-button"/>

                        </HBox>

                    </VBox>

                </StackPane>

            </content>

        </ScrollPane>

    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="6" styleClass="footer">
            <padding>
                <Insets top="8" right="20" bottom="14" left="20"/>
            </padding>

            <HBox alignment="CENTER" spacing="14">
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
                <SVGPath content="M0 14 L16 14 L22 14 L27 3 L35 26 L41 14 L62 14" styleClass="ecg"/>
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
            </HBox>

            <Label text="TeleConsult Medical Consultation System" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>
