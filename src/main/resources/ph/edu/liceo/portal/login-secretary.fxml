<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Secretary sign-in page. Same controller for all four roles; the role comes from the
     sign-in button's userData. Colours live in login-secretary.css, structure in login-theme.css. -->
<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.liceo.portal.controller.LoginController"
            stylesheets="@login-theme.css, @login-secretary.css"
            styleClass="login-page,login-secretary">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="header">
            <padding>
                <Insets top="22" right="50" bottom="14" left="50"/>
            </padding>

            <ImageView fitWidth="50" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@register-logo.png"/>
                </image>
            </ImageView>

            <VBox spacing="1">
                <HBox alignment="BOTTOM_LEFT">
                    <Label text="Tele" styleClass="logo-tele"/>
                    <Label text="Consult" styleClass="logo-consult"/>
                </HBox>
                <Label text="M E D I C A L   S Y S T E M" styleClass="logo-subtitle"/>
            </VBox>

            <Label text="SECRETARY SIGN IN" styleClass="role-badge"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="←  Choose role"
                    fx:id="backButton"
                    onAction="#handleBack"
                    styleClass="back-button"/>

            <Button text="Home"
                    fx:id="homeButton"
                    onAction="#handleHome"
                    styleClass="back-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="login-scroll">
            <content>
                <StackPane styleClass="main-container">
                    <padding>
                        <Insets top="6" right="40" bottom="14" left="40"/>
                    </padding>

                    <HBox alignment="CENTER"
                          maxWidth="980"
                          maxHeight="Infinity"
                          styleClass="login-split">

                        <!-- ===== role panel ===== -->
                        <StackPane minWidth="390" prefWidth="390" maxWidth="390" styleClass="hero-panel">

                            <Region styleClass="hero-orb-big" StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
                            <Region styleClass="hero-orb-small" StackPane.alignment="BOTTOM_LEFT" mouseTransparent="true"/>

                            <VBox alignment="TOP_LEFT" spacing="14" styleClass="hero-content">

                                <Label text="SECRETARY  PORTAL" styleClass="hero-chip"/>

                                <StackPane styleClass="hero-art" alignment="CENTER">
                                    <ImageView fitWidth="280" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@register-secretary.png"/>
                                        </image>
                                    </ImageView>
                                </StackPane>

                                <Label text="Keep the clinic&#10;running smoothly." wrapText="true" styleClass="hero-title"/>
                                <Label text="Confirm schedules, verify accounts and coordinate every appointment." wrapText="true" styleClass="hero-sub"/>

                                <VBox spacing="10" styleClass="feature-list">
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="feature-row">
                            <StackPane styleClass="feature-icon">
                                <SVGPath content="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zM5 10h14v10H5V10zm2 2v2h2v-2H7zm4 0v2h2v-2h-2z" styleClass="feature-glyph"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label text="Confirm schedules" styleClass="feature-title"/>
                                <Label text="Keep bookings organized and on time." wrapText="true" styleClass="feature-desc"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="feature-row">
                            <StackPane styleClass="feature-icon">
                                <SVGPath content="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" styleClass="feature-glyph"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label text="Verify staff accounts" styleClass="feature-title"/>
                                <Label text="Review doctor and nurse registrations." wrapText="true" styleClass="feature-desc"/>
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="feature-row">
                            <StackPane styleClass="feature-icon">
                                <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="feature-glyph"/>
                            </StackPane>
                            <VBox spacing="1">
                                <Label text="Coordinate appointments" styleClass="feature-title"/>
                                <Label text="One view of patients and doctors." wrapText="true" styleClass="feature-desc"/>
                            </VBox>
                        </HBox>
                                </VBox>

                            </VBox>
                        </StackPane>

                        <!-- ===== sign-in form ===== -->
                        <VBox alignment="CENTER_LEFT"
                              spacing="15"
                              HBox.hgrow="ALWAYS"
                              minWidth="420"
                              styleClass="form-panel">

                            <VBox spacing="4">
                                <Label text="W E L C O M E   B A C K" styleClass="eyebrow"/>
                                <Label text="Secretary Sign In" styleClass="title"/>
                                <Label text="Sign in with your verified secretary account." wrapText="true" styleClass="subtitle"/>
                            </VBox>

                            <VBox spacing="7">
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="usernameField"
                                           promptText="Enter your email"
                                           styleClass="login-input"/>
                            </VBox>

                            <VBox spacing="7">
                                <Label text="Password" styleClass="field-label"/>

                                <PasswordField fx:id="passwordField"
                                               promptText="Enter your password"
                                               styleClass="login-input"/>

                                <TextField fx:id="visiblePasswordField"
                                           promptText="Enter your password"
                                           visible="false"
                                           managed="false"
                                           styleClass="login-input"/>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <CheckBox fx:id="showPasswordCheckBox"
                                              text="Show password"
                                              onAction="#handleShowPassword"
                                              styleClass="show-password"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button text="Forgot password?"
                                            fx:id="forgotButton"
                                            onAction="#handleForgotPassword"
                                            styleClass="link-button"/>
                                </HBox>
                            </VBox>

                            <Label fx:id="messageLabel"
                                   text=""
                                   wrapText="true"
                                   styleClass="message"/>

                            <Button text="Sign in as Secretary  →"
                                    fx:id="loginButton"
                                    userData="Secretary"
                                    onAction="#handleLogin"
                                    maxWidth="Infinity"
                                    styleClass="login-submit"/>

                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="Not registered yet?" styleClass="small-text"/>
                                <Button text="Register as a secretary"
                                        fx:id="registerButton"
                                        onAction="#handleRegister"
                                        styleClass="link-button"/>
                            </HBox>

                            <Region styleClass="form-divider" minHeight="1" prefHeight="1" maxHeight="1"/>

                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="switch-strip">
                                <Label text="Not a secretary? Sign in as" styleClass="small-text"/>
                        <Button text="Patient" userData="Patient"
                                onAction="#switchRole" styleClass="switch-chip,switch-chip-patient"/>
                        <Button text="Doctor" userData="Doctor"
                                onAction="#switchRole" styleClass="switch-chip,switch-chip-doctor"/>
                        <Button text="Nurse" userData="Nurse"
                                onAction="#switchRole" styleClass="switch-chip,switch-chip-nurse"/>
                            </HBox>

                        </VBox>
                    </HBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="6" styleClass="footer">
            <padding>
                <Insets top="8" right="20" bottom="14" left="20"/>
            </padding>

            <HBox alignment="CENTER" spacing="14">
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
                <SVGPath content="M0 14 L16 14 L22 14 L27 3 L35 26 L41 14 L62 14" styleClass="ecg"/>
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
            </HBox>

            <Label text="TeleConsult Medical System  •  Secretary Portal" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>
