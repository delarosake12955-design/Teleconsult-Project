<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="card"
      fx:controller="ph.edu.liceo.portal.controller.LogoutConfirmController"
      stylesheets="@popup-theme.css"
      styleClass="popup-card"
      spacing="14"
      alignment="TOP_CENTER"
      prefWidth="440"
      minWidth="440"
      maxWidth="440"
      maxHeight="-Infinity">

    <StackPane styleClass="popup-icon-circle,popup-icon-danger">

        <Region styleClass="popup-glyph,popup-glyph-logout"/>

    </StackPane>

    <Label text="Log out?"
           styleClass="popup-title"/>

    <Label fx:id="messageLabel"
           text="Do you want to log out of TeleConsult?"
           wrapText="true"
           textAlignment="CENTER"
           maxWidth="360"
           styleClass="popup-message"/>

    <HBox alignment="CENTER"
          spacing="8"
          maxWidth="-Infinity"
          styleClass="popup-user-chip">

        <Label fx:id="userLabel"
               text="Signed in"
               styleClass="popup-user-chip-label"/>

    </HBox>

    <HBox spacing="12"
          alignment="CENTER">

        <Button fx:id="noButton"
                text="No, stay"
                onAction="#handleNo"
                styleClass="popup-secondary-button"/>

        <Button fx:id="yesButton"
                text="Yes, log out"
                onAction="#handleYes"
                styleClass="popup-danger-button"/>

    </HBox>

    <HBox alignment="CENTER"
          spacing="6">

        <Label text="Press"
               styleClass="popup-hint"/>

        <Label text="Esc"
               styleClass="popup-key"/>

        <Label text="again to stay signed in"
               styleClass="popup-hint"/>

    </HBox>

</VBox>
