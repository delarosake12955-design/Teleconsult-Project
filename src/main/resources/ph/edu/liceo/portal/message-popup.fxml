<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="card"
      fx:controller="ph.edu.liceo.portal.controller.MessagePopupController"
      stylesheets="@popup-theme.css"
      styleClass="popup-card"
      spacing="14"
      alignment="TOP_CENTER"
      prefWidth="440"
      minWidth="440"
      maxWidth="440"
      maxHeight="-Infinity">

    <StackPane styleClass="popup-icon-circle,popup-icon-success">

        <Label text="✓"
               styleClass="popup-icon"/>

    </StackPane>

    <Label fx:id="titleLabel"
           text="Done"
           styleClass="popup-title"/>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"
           textAlignment="CENTER"
           maxWidth="360"
           styleClass="popup-message"/>

    <Button fx:id="okButton"
            text="OK"
            onAction="#handleOk"
            styleClass="popup-primary-button"/>

</VBox>
