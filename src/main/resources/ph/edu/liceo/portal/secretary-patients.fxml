<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.liceo.portal.controller.PatientController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            stylesheets="@secretary-patients.css, @teleconsult-theme.css">
    <content>
        <VBox spacing="24" styleClass="main-content secretary-page">

            <VBox spacing="5">
                <Label text="Patients" styleClass="page-title"/>
                <Label text="View registered patients and basic account information."
                       styleClass="page-description"/>
            </VBox>

            <HBox spacing="14" styleClass="search-card">
                <TextField fx:id="searchField"
                           promptText="Search patient name or email"
                           HBox.hgrow="ALWAYS"
                           styleClass="search-field"/>
                <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
                <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
            </HBox>

            <VBox spacing="5" styleClass="summary-card">
                <Label text="Registered Patients" styleClass="summary-title"/>
                <Label fx:id="countLabel" text="0" styleClass="summary-number"/>
            </VBox>

            <VBox fx:id="patientList" spacing="12"/>

        </VBox>
    </content>
</ScrollPane>
