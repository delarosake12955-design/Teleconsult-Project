<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.AdminLoginController"
            stylesheets="@admin-login.css, @register-theme.css"
            prefWidth="1200"
            prefHeight="750"
            styleClass="page,reg-page,reg-admin">

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="top-bar">

            <padding>
                <Insets top="22"
                        right="50"
                        bottom="22"
                        left="50"/>
            </padding>

            <ImageView fitWidth="46" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@register-logo.png"/>
                    </image>
                </ImageView>

            <VBox spacing="1">

                <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>

                <Label text="M E D I C A L   S Y S T E M"
                       styleClass="logo-subtitle"/>

            </VBox>

            <Label text="ADMINISTRATION"
                   styleClass="admin-badge"/>

            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="←  Back to Login"
                    fx:id="backButton"
                    onAction="#handleBack"
                    styleClass="back-button"/>

        </HBox>

    </top>

    <center>

        <StackPane styleClass="main-container">

            <!-- GLASS BACKGROUND LAYERS -->

            <StackPane styleClass="glass-layer-one"/>

            <StackPane styleClass="glass-layer-two"/>

            <StackPane styleClass="glass-layer-three"/>


            <!-- LOGIN CARD -->

            <VBox fx:id="loginCard"
                  alignment="CENTER"
                  spacing="20"
                  maxWidth="430"
                  styleClass="login-card">

                <ImageView fitWidth="92" preserveRatio="true" smooth="true">
                                <image>
                                    <Image url="@register-logo.png"/>
                                </image>
                            </ImageView>

                <VBox alignment="CENTER"
                      spacing="7">

                    <Label text="Administrator Access"
                           styleClass="title"/>

                    <Label text="Sign in to manage the TeleConsult system"
                           styleClass="subtitle"
                           wrapText="true"/>

                </VBox>


                <VBox spacing="8"
                      maxWidth="340">

                    <Label text="Admin Email"
                           styleClass="field-label"/>

                    <TextField fx:id="emailField"
                               promptText="Enter administrator email"
                               styleClass="input-field"/>

                </VBox>


                <VBox spacing="8"
                      maxWidth="340">

                    <Label text="Password"
                           styleClass="field-label"/>

                    <PasswordField fx:id="passwordField"
                                   promptText="Enter administrator password"
                                   styleClass="input-field"/>

                    <TextField fx:id="visiblePasswordField"
                               promptText="Enter administrator password"
                               visible="false"
                               managed="false"
                               styleClass="input-field"/>

                </VBox>


                <CheckBox fx:id="showPasswordCheckBox"
                          text="Show password"
                          onAction="#handleShowPassword"
                          styleClass="show-password"/>


                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       maxWidth="340"
                       styleClass="message-label"/>


                <Button fx:id="loginButton"
                        text="Sign in as Administrator  →"
                        onAction="#handleLogin"
                        maxWidth="340"
                        styleClass="login-button"/>


                <Label text="Administrator access is restricted."
                       styleClass="security-text"/>

            </VBox>

        </StackPane>

    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="6" styleClass="footer">
            <padding>
                <Insets top="8" right="20" bottom="14" left="20"/>
            </padding>

            <HBox alignment="CENTER" spacing="14">
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
                <SVGPath content="M0 14 L16 14 L22 14 L27 3 L35 26 L41 14 L62 14" styleClass="ecg"/>
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
            </HBox>

            <Label text="TeleConsult Medical System  •  Administrator Portal" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>