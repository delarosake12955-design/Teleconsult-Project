<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.AdminController"
            stylesheets="@admin-verification-requests.css, @teleconsult-theme.css, @verification-license.css"
            styleClass="page admin-page">

    <left>

        <VBox prefWidth="245"
              spacing="8"
              styleClass="sidebar">

            <padding>
                <Insets top="28"
                        right="18"
                        bottom="25"
                        left="18"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="brand-container">

                <ImageView fitWidth="46" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@register-logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="1">

                    <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>

                    <Label text="M E D I C A L   S Y S T E M"
                           styleClass="sidebar-subtitle"/>

                </VBox>

            </HBox>

            <Label text="ADMIN PORTAL"
                   styleClass="portal-label"/>

            <VBox spacing="6"
                  VBox.vgrow="ALWAYS">

                <Button text="Dashboard"
                        fx:id="dashboardButton"
                        onAction="#handleDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Verification Requests"
                        fx:id="verificationButton"
                        onAction="#handleVerificationRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button-active"/>

                <Button text="Manage Users"
                        fx:id="usersButton"
                        onAction="#handleUsers"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Profile"
                        fx:id="profileButton"
                        onAction="#handleProfile"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

            </VBox>

            <VBox spacing="8"
                  styleClass="sidebar-bottom">

                <Label text="ADMIN ACCOUNT"
                       styleClass="account-label"/>

                <Button text="Logout"
                        fx:id="logoutButton"
                        onAction="#handleLogout"
                        maxWidth="Infinity"
                        styleClass="logout-button"/>

            </VBox>

        </VBox>

    </left>

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="main-scroll">

            <content>

                <VBox spacing="25"
                      styleClass="main-content">

                    <HBox alignment="CENTER_LEFT"
                          spacing="20">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Account Verification"
                                   styleClass="greeting"/>

                            <Label text="Verification Requests"
                                   styleClass="admin-name"/>

                            <Label text="Review and verify new staff account registrations."
                                   styleClass="description"/>

                        </VBox>

                        <VBox alignment="CENTER"
                              spacing="2"
                              styleClass="profile-mini-card">

                            <StackPane styleClass="profile-icon">

                                <Label text="+"
                                       styleClass="profile-plus"/>

                            </StackPane>

                            <Label text="Administrator"
                                   styleClass="profile-name"/>

                            <Label text="Administrator"
                                   styleClass="profile-role"/>

                        </VBox>

                    </HBox>


                    <HBox spacing="16">

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="6"
                              styleClass="quick-card">

                            <HBox spacing="12"
                                  alignment="CENTER_LEFT">

                                <StackPane styleClass="quick-icon">

                                    <Label text="P"
                                           styleClass="quick-icon-text"/>

                                </StackPane>

                                <VBox spacing="2">

                                    <Label text="Pending"
                                           styleClass="quick-title"/>

                                    <Label fx:id="pendingCountLabel"
                                           text="0"
                                           styleClass="overview-number"/>

                                </VBox>

                            </HBox>

                            <Label text="Accounts waiting for approval."
                                   styleClass="quick-description"/>

                        </VBox>


                        <VBox HBox.hgrow="ALWAYS"
                              spacing="6"
                              styleClass="quick-card">

                            <HBox spacing="12"
                                  alignment="CENTER_LEFT">

                                <StackPane styleClass="quick-icon">

                                    <Label text="A"
                                           styleClass="quick-icon-text"/>

                                </StackPane>

                                <VBox spacing="2">

                                    <Label text="Approved"
                                           styleClass="quick-title"/>

                                    <Label fx:id="approvedCountLabel"
                                           text="0"
                                           styleClass="overview-number"/>

                                </VBox>

                            </HBox>

                            <Label text="Approved staff accounts."
                                   styleClass="quick-description"/>

                        </VBox>


                        <VBox HBox.hgrow="ALWAYS"
                              spacing="6"
                              styleClass="quick-card">

                            <HBox spacing="12"
                                  alignment="CENTER_LEFT">

                                <StackPane styleClass="quick-icon">

                                    <Label text="R"
                                           styleClass="quick-icon-text"/>

                                </StackPane>

                                <VBox spacing="2">

                                    <Label text="Rejected"
                                           styleClass="quick-title"/>

                                    <Label fx:id="rejectedCountLabel"
                                           text="0"
                                           styleClass="overview-number"/>

                                </VBox>

                            </HBox>

                            <Label text="Rejected staff accounts."
                                   styleClass="quick-description"/>

                        </VBox>

                    </HBox>


                    <VBox spacing="15"
                          styleClass="upcoming-card">

                        <HBox alignment="CENTER_LEFT"
                              spacing="12">

                            <VBox spacing="4"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Registration Requests"
                                       styleClass="section-title"/>

                                <Label text="Review staff accounts before granting access to the system."
                                       styleClass="section-subtitle"/>

                            </VBox>

                            <ComboBox fx:id="statusFilterComboBox"
                                      promptText="Filter by status"
                                      styleClass="filter-combo-box"/>

                            <Button text="Refresh"
                                    fx:id="refreshButton"
                                    onAction="#handleRefresh"
                                    styleClass="secondary-button"/>

                        </HBox>


                        <TableView fx:id="verificationTable"
                                   prefHeight="400"
                                   styleClass="verification-table">

                            <columns>

                                <TableColumn fx:id="nameColumn"
                                             text="Full Name"
                                             prefWidth="180"/>

                                <TableColumn fx:id="emailColumn"
                                             text="Email"
                                             prefWidth="210"/>

                                <TableColumn fx:id="roleColumn"
                                             text="Role"
                                             prefWidth="130"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="120"/>

                            </columns>

                            <placeholder>

                                <Label text="No verification requests found."
                                       styleClass="empty-label"/>

                            </placeholder>

                        </TableView>

                    </VBox>


                    <VBox spacing="15"
                          styleClass="upcoming-card">

                        <VBox spacing="4">

                            <Label text="Selected Request"
                                   styleClass="section-title"/>

                            <Label text="Review the selected registration before taking action."
                                   styleClass="section-subtitle"/>

                        </VBox>


                        <HBox spacing="15">

                            <VBox HBox.hgrow="ALWAYS" prefWidth="0"
                                  spacing="5"
                                  styleClass="appointment-row">

                                <Label text="NAME"
                                       styleClass="appointment-specialty"/>

                                <Label fx:id="selectedNameLabel"
                                       text="Select a request from the table."
                                       styleClass="appointment-doctor"/>

                            </VBox>


                            <VBox HBox.hgrow="ALWAYS" prefWidth="0"
                                  spacing="5"
                                  styleClass="appointment-row">

                                <Label text="EMAIL"
                                       styleClass="appointment-specialty"/>

                                <Label fx:id="selectedEmailLabel"
                                       text="—"
                                       styleClass="appointment-doctor"/>

                            </VBox>


                            <VBox HBox.hgrow="ALWAYS" prefWidth="0"
                                  spacing="5"
                                  styleClass="appointment-row">

                                <Label text="ROLE"
                                       styleClass="appointment-specialty"/>

                                <Label fx:id="selectedRoleLabel"
                                       text="—"
                                       styleClass="appointment-doctor"/>

                            </VBox>

                        </HBox>


                        <HBox spacing="15">
                        
                            <VBox HBox.hgrow="ALWAYS" prefWidth="0"
                                  spacing="5"
                                  styleClass="appointment-row">
                        
                                <Label text="LICENSE NUMBER"
                                       styleClass="appointment-specialty"/>
                        
                                <Label fx:id="selectedLicenseLabel"
                                       text="—"
                                       styleClass="appointment-doctor"/>
                        
                            </VBox>
                        
                        
                            <VBox HBox.hgrow="ALWAYS" prefWidth="0"
                                  spacing="5"
                                  styleClass="appointment-row">
                        
                                <Label fx:id="selectedDetailTitleLabel"
                                       text="SPECIALTY / DEPARTMENT"
                                       styleClass="appointment-specialty"/>
                        
                                <Label fx:id="selectedDetailLabel"
                                       text="—"
                                       styleClass="appointment-doctor"/>
                        
                            </VBox>
                        
                        
                            <VBox HBox.hgrow="ALWAYS" prefWidth="0"
                                  spacing="5"
                                  styleClass="appointment-row">
                        
                                <Label text="ACCOUNT STATUS"
                                       styleClass="appointment-specialty"/>
                        
                                <Label fx:id="selectedStatusLabel"
                                       text="—"
                                       styleClass="appointment-doctor"/>
                        
                            </VBox>
                        
                        </HBox>


                        <Label fx:id="messageLabel"
                               text=""
                               wrapText="true"
                               styleClass="message"/>


                        <HBox spacing="12">

                            <Button text="Approve"
                                    fx:id="approveButton"
                                    onAction="#handleApprove"
                                    styleClass="primary-button"/>

                            <Button text="Reject"
                                    fx:id="rejectButton"
                                    onAction="#handleReject"
                                    styleClass="reject-button"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>