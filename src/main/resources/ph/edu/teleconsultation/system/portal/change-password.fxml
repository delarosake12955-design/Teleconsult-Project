<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="card"
      fx:controller="ph.edu.teleconsultation.system.portal.controller.ChangePasswordController"
      stylesheets="@popup-theme.css"
      styleClass="popup-card"
      spacing="12"
      alignment="TOP_CENTER"
      prefWidth="460"
      minWidth="460"
      maxWidth="460"
      maxHeight="-Infinity">

    <StackPane styleClass="popup-icon-circle,popup-icon-info">

        <Region styleClass="popup-glyph,popup-glyph-lock"/>

    </StackPane>

    <Label text="Change Password"
           styleClass="popup-title"/>

    <Label text="Enter your current password, then choose a new one."
           wrapText="true"
           textAlignment="CENTER"
           maxWidth="380"
           styleClass="popup-message"/>

    <VBox spacing="6"
          maxWidth="380">

        <Label text="Current password"
               styleClass="popup-field-label"/>

        <PasswordField fx:id="currentField"
                       promptText="Enter your current password"
                       onAction="#handleCurrentEnter"
                       styleClass="popup-field"/>

        <TextField fx:id="currentVisibleField"
                   promptText="Enter your current password"
                   visible="false"
                   managed="false"
                   onAction="#handleCurrentEnter"
                   styleClass="popup-field"/>

    </VBox>

    <VBox spacing="6"
          maxWidth="380">

        <Label text="New password"
               styleClass="popup-field-label"/>

        <PasswordField fx:id="newField"
                       promptText="Enter a new password"
                       onAction="#handleNewEnter"
                       styleClass="popup-field"/>

        <TextField fx:id="newVisibleField"
                   promptText="Enter a new password"
                   visible="false"
                   managed="false"
                   onAction="#handleNewEnter"
                   styleClass="popup-field"/>

        <Label text="8+ characters with uppercase, lowercase, number and special character."
               styleClass="popup-rules"/>

    </VBox>

    <VBox spacing="6"
          maxWidth="380">

        <Label text="Confirm new password"
               styleClass="popup-field-label"/>

        <PasswordField fx:id="confirmField"
                       promptText="Re-enter the new password"
                       onAction="#handleSave"
                       styleClass="popup-field"/>

        <TextField fx:id="confirmVisibleField"
                   promptText="Re-enter the new password"
                   visible="false"
                   managed="false"
                   onAction="#handleSave"
                   styleClass="popup-field"/>

    </VBox>

    <CheckBox fx:id="showPasswordCheckBox"
              text="Show passwords"
              onAction="#handleShowPassword"
              styleClass="popup-check"/>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"
           textAlignment="CENTER"
           maxWidth="380"
           styleClass="popup-form-message"/>

    <HBox spacing="12"
          alignment="CENTER">

        <Button fx:id="cancelButton"
                text="Cancel"
                onAction="#handleCancel"
                styleClass="popup-secondary-button"/>

        <Button fx:id="saveButton"
                text="Update Password"
                onAction="#handleSave"
                styleClass="popup-primary-button"/>

    </HBox>

    <HBox alignment="CENTER"
          spacing="6">

        <Label text="Press"
               styleClass="popup-hint"/>

        <Label text="Esc"
               styleClass="popup-key"/>

        <Label text="to cancel"
               styleClass="popup-hint"/>

    </HBox>

</VBox>
