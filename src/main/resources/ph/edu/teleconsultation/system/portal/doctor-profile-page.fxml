<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.ProfileController"
            stylesheets="@doctor-profile-page.css, @teleconsult-theme.css, @profile-blue.css, @profile-customize.css">

    <left>

        <VBox prefWidth="235"
              spacing="8"
              styleClass="sidebar doctor-page">

            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>

            <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>

            <Label text="MY PROFILE"
                   styleClass="portal-label"/>

            <VBox spacing="6"
                  VBox.vgrow="ALWAYS">

                <Button text="Dashboard"
                        fx:id="dashboardButton"
                        onAction="#handleDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Appointments"
                        fx:id="appointmentsButton"
                        onAction="#handleAppointments"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Doctors"
                        fx:id="doctorsButton"
                        onAction="#handleDoctors"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Medical Records"
                        fx:id="recordsButton"
                        onAction="#handleMedicalRecords"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Profile"
                        fx:id="profileButton"
                        onAction="#handleProfile"
                        maxWidth="Infinity"
                        styleClass="nav-button-active"/>

            </VBox>

            <Button text="Logout"
                    fx:id="logoutButton"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

        </VBox>

    </left>

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="25"
                  styleClass="main-content">

                <VBox spacing="7">

                    <Label text="My Profile"
                           styleClass="page-title"/>

                    <Label text="View and manage your personal account information."
                           styleClass="page-description"/>

                </VBox>

                <HBox spacing="20"
                      styleClass="profile-header">

                    <VBox alignment="CENTER"
                          prefWidth="115"
                          prefHeight="115"
                          styleClass="profile-avatar">

                        <Label fx:id="avatarLabel"
                               text="ME"
                               styleClass="avatar-text"/>

                    </VBox>

                    <VBox spacing="7"
                          HBox.hgrow="ALWAYS">

                        <Label fx:id="nameLabel"
                               text="User Name"
                               styleClass="profile-name"/>

                        <Label fx:id="roleLabel"
                               text="Patient"
                               styleClass="profile-role"/>

                        <Label fx:id="emailHeaderLabel"
                               text="user@email.com"
                               styleClass="profile-email"/>
                        <Label fx:id="bioHeaderLabel" text="" wrapText="true" maxWidth="560" visible="false" managed="false" styleClass="profile-bio"/>

                    </VBox>

                </HBox>

                <VBox spacing="18"
                      styleClass="customize-card">

                    <VBox spacing="3">
                        <Label text="Customize Profile"
                               styleClass="section-title"/>
                        <Label text="Make your profile yours. Your header above shows a live preview."
                               styleClass="customize-hint"/>
                    </VBox>

                    <HBox spacing="30">

                        <VBox spacing="10"
                              HBox.hgrow="ALWAYS"
                              prefWidth="0">
                            <Label text="Profile Photo"
                                   styleClass="field-label"/>
                            <HBox spacing="10">
                                <Button fx:id="choosePhotoButton"
                                        text="Choose photo"
                                        onAction="#handleChoosePhoto"
                                        styleClass="customize-button"/>
                                <Button fx:id="removePhotoButton"
                                        text="Remove"
                                        onAction="#handleRemovePhoto"
                                        styleClass="customize-button-ghost"/>
                            </HBox>
                            <Label text="PNG, JPG or GIF, up to 5 MB."
                                   styleClass="customize-hint"/>
                        </VBox>

                        <VBox spacing="10"
                              HBox.hgrow="ALWAYS"
                              prefWidth="0">
                            <Label text="Color Theme"
                                   styleClass="field-label"/>
                            <HBox fx:id="themeSwatches"
                                  spacing="10"/>
                            <Label fx:id="themeNameLabel"
                                   text="Ocean Blue"
                                   styleClass="customize-hint"/>
                        </VBox>

                    </HBox>

                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="About Me"
                                   styleClass="field-label"
                                   HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                            <Label fx:id="bioCounterLabel"
                                   text="0 / 140"
                                   styleClass="customize-hint"/>
                        </HBox>
                        <TextArea fx:id="bioArea"
                                  promptText="Write a short line about yourself..."
                                  prefRowCount="3"
                                  wrapText="true"
                                  styleClass="text-area"/>
                    </VBox>

                    <HBox spacing="12"
                          alignment="CENTER_LEFT">
                        <Button fx:id="saveCustomButton"
                                text="Save Customization"
                                onAction="#handleSaveCustomization"
                                styleClass="primary-button"/>
                        <Button text="Reset to Default"
                                onAction="#handleResetCustomization"
                                styleClass="customize-button-ghost"/>
                        <Label fx:id="customMessageLabel"
                               text=""
                               wrapText="true"
                               styleClass="customize-hint"/>
                    </HBox>

                </VBox>

                <VBox spacing="18"
                      styleClass="information-card">

                    <Label text="Personal Information"
                           styleClass="section-title"/>

                    <HBox spacing="15">

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Full Name"
                                   styleClass="field-label"/>

                            <TextField fx:id="fullNameField"
                                       promptText="Enter full name"
                                       styleClass="text-field"/>

                        </VBox>

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Email"
                                   styleClass="field-label"/>

                            <TextField fx:id="emailField"
                                       promptText="Enter email"
                                       styleClass="text-field"/>

                        </VBox>

                    </HBox>

                    <HBox spacing="15">

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Phone Number"
                                   styleClass="field-label"/>

                            <TextField fx:id="phoneField"
                                       promptText="Enter phone number"
                                       styleClass="text-field"/>

                        </VBox>

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Date of Birth"
                                   styleClass="field-label"/>

                            <TextField fx:id="dateOfBirthField"
                                       promptText="Enter date of birth"
                                       styleClass="text-field"/>

                        </VBox>

                    </HBox>

                    <VBox spacing="6">

                        <Label text="Address"
                               styleClass="field-label"/>

                        <TextField fx:id="addressField"
                                   promptText="Enter address"
                                   styleClass="text-field"/>

                    </VBox>

                    <Label fx:id="messageLabel"
                           text=""
                           wrapText="true"
                           styleClass="message"/>

                    <Button text="Save Changes"
                            fx:id="saveButton"
                            onAction="#handleSave"
                            styleClass="primary-button"/>

                </VBox>

                <VBox spacing="18"
                      styleClass="account-card">

                    <Label text="Account Information"
                           styleClass="section-title"/>

                    <HBox spacing="15">

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="5"
                              styleClass="account-item">

                            <Label text="Account Status"
                                   styleClass="account-title"/>

                            <Label fx:id="statusLabel"
                                   text="ACTIVE"
                                   styleClass="status-label"/>

                        </VBox>

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="5"
                              styleClass="account-item">

                            <Label text="Account Type"
                                   styleClass="account-title"/>

                            <Label fx:id="accountTypeLabel"
                                   text="Patient"
                                   styleClass="account-value"/>

                        </VBox>

                    </HBox>

                    <HBox spacing="15"
                          alignment="CENTER_LEFT"
                          styleClass="account-item">

                        <VBox HBox.hgrow="ALWAYS"
                              spacing="5">

                            <Label text="Password"
                                   styleClass="account-title"/>

                            <Label text="Change it regularly to keep your account safe."
                                   styleClass="account-value"/>

                        </VBox>

                        <Button text="Change Password"
                                fx:id="changePasswordButton"
                                onAction="#handleChangePassword"
                                styleClass="secondary-button"/>

                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>