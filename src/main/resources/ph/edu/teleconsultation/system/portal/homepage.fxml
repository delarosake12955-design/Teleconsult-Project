<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.HomeController"
            styleClass="page">

    <stylesheets>
        <URL value="@homepage.css"/>
        <URL value="@role-icons.css"/>
    </stylesheets>

    <!-- =========================
         LEFT SIDEBAR
         ========================= -->

    <left>

        <VBox styleClass="sidebar"
              prefWidth="272"
              spacing="0">

            <!-- BRAND -->

            <VBox styleClass="brand-section"
                  spacing="4">

                <HBox alignment="CENTER_LEFT"
                      spacing="14">

                    <ImageView fitWidth="46" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@register-logo.png"/>
                    </image>
                </ImageView>

                    <VBox spacing="1">

                        <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>

                        <Label text="M E D I C A L   S Y S T E M"
                               styleClass="brand-subtitle"/>

                    </VBox>

                </HBox>

            </VBox>


            <!-- NAVIGATION -->

            <VBox styleClass="navigation"
                  spacing="10">

                <Label text="MENU"
                       styleClass="menu-title"/>


                <Button text="⌂   Home"
                        onAction="#handleHome"
                        styleClass="nav-button"
                        maxWidth="1.7976931348623157E308"/>


                <Button text="○   About"
                        onAction="#handleAbout"
                        styleClass="nav-button"
                        maxWidth="1.7976931348623157E308"/>


                <Button text="≡   Services"
                        onAction="#handleServices"
                        styleClass="nav-button"
                        maxWidth="1.7976931348623157E308"/>


                <Button text="□   Contact"
                        onAction="#handleContact"
                        styleClass="nav-button"
                        maxWidth="1.7976931348623157E308"/>

            </VBox>


            <!-- SPACE -->

            <VBox VBox.vgrow="ALWAYS"/>


            <!-- SYSTEM STATUS -->

            <VBox styleClass="system-card"
                  spacing="12">

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Circle radius="6"
                            styleClass="system-dot"/>

                    <Label text="System Online"
                           styleClass="system-title"/>

                </HBox>

                <Label text="All medical services&#10;are currently operational."
                       styleClass="system-description"/>

            </VBox>


            <!-- SIDEBAR FOOTER -->

            <VBox styleClass="sidebar-footer">

                <Label text="Better Care."
                       styleClass="sidebar-slogan"/>

                <Label text="Closer to You."
                       styleClass="sidebar-slogan"/>

            </VBox>

        </VBox>

    </left>


    <!-- =========================
         MAIN AREA
         ========================= -->

    <center>

        <VBox styleClass="main-area"
              spacing="0">


            <!-- TOP BAR -->

            <HBox styleClass="topbar"
                  alignment="CENTER_RIGHT"
                  spacing="18">

                <Label text="Healthcare made simpler."
                       styleClass="topbar-text"/>


                <Button text="Sign In"
                        onAction="#handleLogin"
                        styleClass="topbar-outline-button"/>


                <Button text="Get Started  →"
                        onAction="#handleRegister"
                        styleClass="topbar-primary-button"/>

            </HBox>


            <!-- =========================
                 SCROLLABLE CONTENT
                 ========================= -->

            <ScrollPane fx:id="contentScrollPane"
                        fitToWidth="true"
                        fitToHeight="false"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="content-scroll">

                <content>

                    <VBox fx:id="contentWrapper"
                          styleClass="content"
                          spacing="28">


                        <!-- =========================
                             HERO SECTION
                             ========================= -->

                        <GridPane styleClass="hero-grid"
                                  hgap="35"
                                  vgap="20">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="55"/>

                                <ColumnConstraints percentWidth="45"/>

                            </columnConstraints>


                            <rowConstraints>

                                <RowConstraints percentHeight="100"/>

                            </rowConstraints>


                            <!-- HERO LEFT -->

                            <VBox GridPane.columnIndex="0"
                                  styleClass="hero-section"
                                  spacing="0">

                                <HBox alignment="CENTER_LEFT"
                                      spacing="9"
                                      maxWidth="-Infinity"
                                      styleClass="hero-badge">

                                    <Circle radius="4"
                                            styleClass="hero-badge-dot"/>

                                    <Label text="WELCOME TO TELECONSULT"
                                           styleClass="eyebrow"/>

                                </HBox>


                                <Label text="Healthcare that"
                                       styleClass="hero-title"/>


                                <Label text="comes to you."
                                       styleClass="hero-title-accent"/>


                                <Label text="Request an appointment, get reviewed by our care team,&#10;and receive your confirmed schedule, all in one place."
                                       styleClass="hero-description"/>


                                <!-- HERO BUTTONS -->

                                <HBox styleClass="hero-buttons"
                                      spacing="12">

                                    <Button text="Get Started  →"
                                            onAction="#handleRegister"
                                            styleClass="hero-primary-button"/>


                                    <Button text="Sign In"
                                            onAction="#handleLogin"
                                            styleClass="hero-secondary-button"/>

                                </HBox>


                                <!-- QUICK STATS -->

                                <HBox styleClass="quick-stats"
                                      spacing="12">


                                    <VBox styleClass="quick-stat"
                                          spacing="4">

                                        <Label text="5"
                                               styleClass="stat-number"/>

                                        <Label text="USER ROLES"
                                               styleClass="stat-label"/>

                                    </VBox>


                                    <VBox styleClass="quick-stat"
                                          spacing="4">

                                        <Label text="3"
                                               styleClass="stat-number"/>

                                        <Label text="REVIEW STEPS"
                                               styleClass="stat-label"/>

                                    </VBox>


                                    <VBox styleClass="quick-stat"
                                          spacing="4">

                                        <Label text="24/7"
                                               styleClass="stat-number"/>

                                        <Label text="ACCESS"
                                               styleClass="stat-label"/>

                                    </VBox>

                                </HBox>

                            </VBox>


                            <!-- HERO RIGHT -->

                            <StackPane GridPane.columnIndex="1"
                                       fx:id="medicalCard"
                                       styleClass="medical-card">


                                <Circle radius="140"
                                        styleClass="medical-glow"/>


                                <Circle radius="92"
                                        styleClass="medical-glow-inner"/>


                                <VBox alignment="CENTER"
                                      spacing="10">


                                    <StackPane styleClass="medical-icon">

                                        <Label text="+"
                                               styleClass="large-plus"/>

                                    </StackPane>


                                    <Label text="TELECONSULT"
                                           styleClass="medical-title"/>


                                    <Label text="M E D I C A L   S Y S T E M"
                                           styleClass="medical-subtitle"/>


                                    <HBox spacing="14"
                                          alignment="CENTER"
                                          styleClass="role-strip">

                                        <VBox alignment="CENTER"
                                              spacing="6">

                                            <StackPane styleClass="role-tile,role-tile-sm,role-tile-patient">

                                                <Region styleClass="role-icon,role-icon-sm,role-icon-patient"/>

                                            </StackPane>

                                            <Label text="PATIENT"
                                                   styleClass="role-strip-label"/>

                                        </VBox>

                                        <VBox alignment="CENTER"
                                              spacing="6">

                                            <StackPane styleClass="role-tile,role-tile-sm,role-tile-doctor">

                                                <Region styleClass="role-icon,role-icon-sm,role-icon-doctor"/>

                                            </StackPane>

                                            <Label text="DOCTOR"
                                                   styleClass="role-strip-label"/>

                                        </VBox>

                                        <VBox alignment="CENTER"
                                              spacing="6">

                                            <StackPane styleClass="role-tile,role-tile-sm,role-tile-nurse">

                                                <Region styleClass="role-icon,role-icon-sm,role-icon-nurse"/>

                                            </StackPane>

                                            <Label text="NURSE"
                                                   styleClass="role-strip-label"/>

                                        </VBox>

                                        <VBox alignment="CENTER"
                                              spacing="6">

                                            <StackPane styleClass="role-tile,role-tile-sm,role-tile-secretary">

                                                <Region styleClass="role-icon,role-icon-sm,role-icon-secretary"/>

                                            </StackPane>

                                            <Label text="SECRETARY"
                                                   styleClass="role-strip-label"/>

                                        </VBox>

                                    </HBox>


                                    <HBox spacing="8"
                                          alignment="CENTER">

                                        <Circle radius="4"
                                                styleClass="online-dot"/>

                                        <Label text="SERVICES ACTIVE"
                                               styleClass="medical-status"/>

                                    </HBox>

                                </VBox>

                            </StackPane>

                        </GridPane>


                        <!-- =========================
                             SERVICES SECTION
                             ========================= -->

                        <GridPane fx:id="servicesSection"
                                  styleClass="feature-grid"
                                  hgap="16">


                            <columnConstraints>

                                <ColumnConstraints percentWidth="25"/>

                                <ColumnConstraints percentWidth="25"/>

                                <ColumnConstraints percentWidth="25"/>

                                <ColumnConstraints percentWidth="25"/>

                            </columnConstraints>


                            <!-- APPOINTMENTS -->

                            <VBox GridPane.columnIndex="0"
                                  styleClass="feature-card"
                                  spacing="12">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="▣"
                                           styleClass="feature-icon"/>

                                    <Label text="01"
                                           styleClass="feature-number"/>

                                </HBox>


                                <Label text="Appointments"
                                       styleClass="feature-title"/>


                                <Label text="Book and manage your healthcare appointments with ease."
                                       wrapText="true"
                                       styleClass="feature-description"/>

                            </VBox>


                            <!-- DOCTORS -->

                            <VBox GridPane.columnIndex="1"
                                  styleClass="feature-card"
                                  spacing="12">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="♙"
                                           styleClass="feature-icon"/>

                                    <Label text="02"
                                           styleClass="feature-number"/>

                                </HBox>


                                <Label text="Doctors"
                                       styleClass="feature-title"/>


                                <Label text="Browse available doctors and view their specialties."
                                       wrapText="true"
                                       styleClass="feature-description"/>

                            </VBox>


                            <!-- MEDICAL RECORDS -->

                            <VBox GridPane.columnIndex="2"
                                  styleClass="feature-card"
                                  spacing="12">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="□"
                                           styleClass="feature-icon"/>

                                    <Label text="03"
                                           styleClass="feature-number"/>

                                </HBox>


                                <Label text="Medical Records"
                                       styleClass="feature-title"/>


                                <Label text="Keep important medical information organized and accessible."
                                       wrapText="true"
                                       styleClass="feature-description"/>

                            </VBox>


                            <!-- CONSULTATIONS -->

                            <VBox GridPane.columnIndex="3"
                                  styleClass="feature-card"
                                  spacing="12">

                                <HBox alignment="CENTER_LEFT">

                                    <Label text="+"
                                           styleClass="feature-icon"/>

                                    <Label text="04"
                                           styleClass="feature-number"/>

                                </HBox>


                                <Label text="Consultations"
                                       styleClass="feature-title"/>


                                <Label text="Submit and monitor consultation requests easily."
                                       wrapText="true"
                                       styleClass="feature-description"/>

                            </VBox>

                        </GridPane>


                        <!-- =========================
                             ABOUT SECTION
                             ========================= -->

                        <VBox fx:id="aboutSection"
                              styleClass="information-card"
                              spacing="10">


                            <Label text="ABOUT TELECONSULT"
                                   styleClass="information-label"/>


                            <Label text="Modern healthcare management"
                                   styleClass="information-title"/>


                            <Label text="TeleConsult Medical System is a healthcare platform designed to organize appointments, doctors, consultations, and medical records in one organized system."
                                   wrapText="true"
                                   styleClass="information-description"/>

                        </VBox>


                        <!-- =========================
                             CONTACT SECTION
                             ========================= -->

                        <GridPane styleClass="bottom-grid"
                                  hgap="16">


                            <columnConstraints>

                                <ColumnConstraints percentWidth="75"/>

                                <ColumnConstraints percentWidth="25"/>

                            </columnConstraints>


                            <!-- CONTACT -->

                            <VBox fx:id="contactSection"
                                  GridPane.columnIndex="0"
                                  styleClass="information-card"
                                  spacing="8">


                                <Label text="CONTACT TELECONSULT"
                                       styleClass="information-label"/>


                                <Label text="Need assistance?"
                                       styleClass="information-title"/>


                                <Label text="For assistance with the TeleConsult system, please contact the system administrator or your assigned healthcare staff."
                                       wrapText="true"
                                       styleClass="information-description"/>

                            </VBox>


                            <!-- SYSTEM STATS -->

                            <HBox GridPane.columnIndex="1"
                                  styleClass="system-stats"
                                  alignment="CENTER"
                                  spacing="20">


                                <VBox alignment="CENTER"
                                      spacing="4">

                                    <Label text="5"
                                           styleClass="bottom-stat-number"/>

                                    <Label text="ROLES"
                                           styleClass="bottom-stat-label"/>

                                </VBox>


                                <VBox styleClass="stat-divider"/>


                                <VBox alignment="CENTER"
                                      spacing="4">

                                    <Label text="3"
                                           styleClass="bottom-stat-number"/>

                                    <Label text="REVIEWS"
                                           styleClass="bottom-stat-label"/>

                                </VBox>


                                <VBox styleClass="stat-divider"/>


                                <VBox alignment="CENTER"
                                      spacing="4">

                                    <Label text="24/7"
                                           styleClass="bottom-stat-number"/>

                                    <Label text="ACCESS"
                                           styleClass="bottom-stat-label"/>

                                </VBox>

                            </HBox>

                        </GridPane>


                        <!-- =========================
                             FOOTER
                             ========================= -->

                        <HBox styleClass="footer"
                              alignment="CENTER">

                            <Label text="TeleConsult Medical System  •  JavaFX Healthcare Platform"
                                   styleClass="footer-text"/>

                        </HBox>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
