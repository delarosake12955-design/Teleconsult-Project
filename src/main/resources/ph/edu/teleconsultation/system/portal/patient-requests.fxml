<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.ConsultationRequestController"
            stylesheets="@patient-requests.css, @teleconsult-theme.css, @date-picker-theme.css">

    <left>

        <VBox prefWidth="235"
              spacing="8"
              styleClass="sidebar patient-page">

            <padding>
                <Insets top="30"
                        right="20"
                        bottom="30"
                        left="20"/>
            </padding>

            <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>

            <Label text="CONSULTATION REQUESTS"
                   styleClass="portal-label"/>

            <VBox spacing="6"
                  VBox.vgrow="ALWAYS">

                <Button text="Dashboard"
                        fx:id="dashboardButton"
                        onAction="#handleDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Appointments"
                        fx:id="appointmentsButton"
                        onAction="#handleAppointments"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Requests"
                        fx:id="requestsButton"
                        onAction="#handleRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button-active"/>

                <Button text="Medical Records"
                        fx:id="recordsButton"
                        onAction="#handleMedicalRecords"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Profile"
                        fx:id="profileButton"
                        onAction="#handleProfile"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

            </VBox>

            <Button text="Logout"
                    fx:id="logoutButton"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

        </VBox>

    </left>

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="25"
                  styleClass="main-content">

                <VBox spacing="7">

                    <Label text="Consultation Requests"
                           styleClass="page-title"/>

                    <Label text="Review and manage consultation requests."
                           styleClass="page-description"/>

                </VBox>

                <HBox spacing="16">

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="6"
                          styleClass="summary-card">

                        <Label text="Total Requests"
                               styleClass="summary-title"/>

                        <Label fx:id="totalRequestsLabel"
                               text="0"
                               styleClass="summary-number"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="6"
                          styleClass="summary-card">

                        <Label text="Pending"
                               styleClass="summary-title"/>

                        <Label fx:id="pendingRequestsLabel"
                               text="0"
                               styleClass="summary-number"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="6"
                          styleClass="summary-card">

                        <Label text="Approved"
                               styleClass="summary-title"/>

                        <Label fx:id="approvedRequestsLabel"
                               text="0"
                               styleClass="summary-number"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="6"
                          styleClass="summary-card">

                        <Label text="Rejected"
                               styleClass="summary-title"/>

                        <Label fx:id="rejectedRequestsLabel"
                               text="0"
                               styleClass="summary-number"/>

                    </VBox>

                </HBox>

                <VBox spacing="15"
                      styleClass="request-form-card">

                    <Label text="Create Consultation Request"
                           styleClass="section-title"/>

                    <HBox spacing="14">

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Patient"
                                   styleClass="field-label"/>

                            <Label fx:id="patientNameLabel"
                                   text="Current Patient"
                                   styleClass="field-value"/>

                        </VBox>

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Doctor"
                                   styleClass="field-label"/>

                            <ComboBox fx:id="doctorComboBox"
                                      promptText="Select a doctor"
                                      maxWidth="Infinity"
                                      styleClass="combo-box"/>

                        </VBox>

                    </HBox>

                    <HBox spacing="14">

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Reason"
                                   styleClass="field-label"/>

                            <TextArea fx:id="reasonArea"
                                      promptText="Describe your symptoms or reason for consultation"
                                      prefRowCount="3"
                                      wrapText="true"
                                      styleClass="text-area"/>

                        </VBox>

                        <VBox spacing="6"
                              HBox.hgrow="ALWAYS">

                            <Label text="Date"
                                   styleClass="field-label"/>

                            <DatePicker fx:id="datePicker"
                                        maxWidth="Infinity"
                                        styleClass="date-picker"/>

                        </VBox>

                    </HBox>

                    <Label fx:id="messageLabel"
                           text=""
                           wrapText="true"
                           styleClass="message"/>

                    <Button text="Submit Request"
                            fx:id="submitRequestButton"
                            onAction="#handleSubmitRequest"
                            styleClass="primary-button"/>

                </VBox>

                <VBox spacing="14"
                      styleClass="table-card">

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="Request History"
                                   styleClass="section-title"/>

                            <Label text="View consultation requests and their current status."
                                   styleClass="table-description"/>

                        </VBox>

                        <ComboBox fx:id="statusFilterComboBox"
                                  promptText="Filter by status"
                                  styleClass="filter-combo-box"/>

                        <Button text="Refresh"
                                fx:id="refreshButton"
                                onAction="#handleRefresh"
                                styleClass="secondary-button"/>

                    </HBox>

                    <TableView fx:id="requestTable"
                               prefHeight="380"
                               styleClass="request-table">

                        <columns>

                            <TableColumn fx:id="patientColumn"
                                         text="Patient"
                                         prefWidth="160"/>

                            <TableColumn fx:id="doctorColumn"
                                         text="Doctor"
                                         prefWidth="160"/>

                            <TableColumn fx:id="reasonColumn"
                                         text="Reason"
                                         prefWidth="220"/>

                            <TableColumn fx:id="dateColumn"
                                         text="Date"
                                         prefWidth="120"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="120"/>

                        </columns>

                        <placeholder>

                            <Label text="No consultation requests found."
                                   styleClass="empty-label"/>

                        </placeholder>

                    </TableView>

                </VBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>