<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.RegisterController"
            styleClass="page">

    <stylesheets>
        <URL value="@register.css"/>
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="24" styleClass="header">
            <padding>
                <Insets top="22" right="44" bottom="10" left="44"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <ImageView fitWidth="56" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@register-logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="1">
                    <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>
                    <Label text="M E D I C A L   S Y S T E M" styleClass="logo-subtitle"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="26" HBox.hgrow="ALWAYS">
                <Label text="Better Access   •   Better Care   •   Healthier Tomorrow"
                       styleClass="tagline"/>

                <Button text="&#8592;  Back to Home"
                        fx:id="homeButton"
                        onAction="#handleHome"
                        styleClass="back-button"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="register-scroll">
            <content>
                <VBox alignment="TOP_CENTER" spacing="16" styleClass="content">
                    <padding>
                        <Insets top="14" right="40" bottom="26" left="40"/>
                    </padding>

                    <Label text="J O I N   T E L E C O N S U L T" styleClass="eyebrow"/>

                    <HBox alignment="CENTER" spacing="14">
                        <Label text="Choose Your" styleClass="title"/>
                        <Label text="Role" styleClass="title-accent"/>
                    </HBox>

                    <Label text="Create your account and be part of our medical community.&#10;Select the role that best describes you."
                           textAlignment="CENTER"
                           styleClass="subtitle"/>

                    <FlowPane hgap="26" vgap="26"
                              alignment="CENTER"
                              prefWrapLength="1400"
                              styleClass="role-grid">

                    <Button fx:id="doctorButton"
                            onAction="#handleDoctor"
                            contentDisplay="GRAPHIC_ONLY"
                            minWidth="316" prefWidth="316" maxWidth="316"
                            styleClass="role-card,role-card-doctor">
                        <graphic>
                            <VBox alignment="TOP_LEFT" spacing="6"
                                  minWidth="316" prefWidth="316" maxWidth="316"
                                  styleClass="role-card-body">
                                <StackPane alignment="CENTER" styleClass="role-art">
                                    <ImageView fitWidth="300" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@register-doctor.png"/>
                                        </image>
                                    </ImageView>
                                </StackPane>
                                <Label text="Doctor" styleClass="role-name,role-name-doctor"/>
                                <Label text="Review requests, run consultations and manage patient care."
                                       wrapText="true"
                                       minWidth="272" prefWidth="272" maxWidth="272"
                                       minHeight="66" prefHeight="66"
                                       styleClass="role-desc"/>
                                <HBox alignment="CENTER" spacing="12"
                                      styleClass="role-pill,role-pill-doctor">
                                    <Label text="Register" styleClass="role-pill-text"/>
                                    <Label text="&#8594;" styleClass="role-pill-text"/>
                                </HBox>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="patientButton"
                            onAction="#handlePatient"
                            contentDisplay="GRAPHIC_ONLY"
                            minWidth="316" prefWidth="316" maxWidth="316"
                            styleClass="role-card,role-card-patient">
                        <graphic>
                            <VBox alignment="TOP_LEFT" spacing="6"
                                  minWidth="316" prefWidth="316" maxWidth="316"
                                  styleClass="role-card-body">
                                <StackPane alignment="CENTER" styleClass="role-art">
                                    <ImageView fitWidth="300" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@register-patient.png"/>
                                        </image>
                                    </ImageView>
                                </StackPane>
                                <Label text="Patient" styleClass="role-name,role-name-patient"/>
                                <Label text="Book appointments, send consultation requests and view your health records."
                                       wrapText="true"
                                       minWidth="272" prefWidth="272" maxWidth="272"
                                       minHeight="66" prefHeight="66"
                                       styleClass="role-desc"/>
                                <HBox alignment="CENTER" spacing="12"
                                      styleClass="role-pill,role-pill-patient">
                                    <Label text="Register" styleClass="role-pill-text"/>
                                    <Label text="&#8594;" styleClass="role-pill-text"/>
                                </HBox>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="nurseButton"
                            onAction="#handleNurse"
                            contentDisplay="GRAPHIC_ONLY"
                            minWidth="316" prefWidth="316" maxWidth="316"
                            styleClass="role-card,role-card-nurse">
                        <graphic>
                            <VBox alignment="TOP_LEFT" spacing="6"
                                  minWidth="316" prefWidth="316" maxWidth="316"
                                  styleClass="role-card-body">
                                <StackPane alignment="CENTER" styleClass="role-art">
                                    <ImageView fitWidth="300" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@register-nurse.png"/>
                                        </image>
                                    </ImageView>
                                </StackPane>
                                <Label text="Nurse" styleClass="role-name,role-name-nurse"/>
                                <Label text="Review requests, check vital signs and support patient care."
                                       wrapText="true"
                                       minWidth="272" prefWidth="272" maxWidth="272"
                                       minHeight="66" prefHeight="66"
                                       styleClass="role-desc"/>
                                <HBox alignment="CENTER" spacing="12"
                                      styleClass="role-pill,role-pill-nurse">
                                    <Label text="Register" styleClass="role-pill-text"/>
                                    <Label text="&#8594;" styleClass="role-pill-text"/>
                                </HBox>
                            </VBox>
                        </graphic>
                    </Button>

                    <Button fx:id="secretaryButton"
                            onAction="#handleSecretary"
                            contentDisplay="GRAPHIC_ONLY"
                            minWidth="316" prefWidth="316" maxWidth="316"
                            styleClass="role-card,role-card-secretary">
                        <graphic>
                            <VBox alignment="TOP_LEFT" spacing="6"
                                  minWidth="316" prefWidth="316" maxWidth="316"
                                  styleClass="role-card-body">
                                <StackPane alignment="CENTER" styleClass="role-art">
                                    <ImageView fitWidth="300" preserveRatio="true" smooth="true">
                                        <image>
                                            <Image url="@register-secretary.png"/>
                                        </image>
                                    </ImageView>
                                </StackPane>
                                <Label text="Secretary" styleClass="role-name,role-name-secretary"/>
                                <Label text="Confirm schedules, verify staff accounts and keep appointments running smoothly."
                                       wrapText="true"
                                       minWidth="272" prefWidth="272" maxWidth="272"
                                       minHeight="66" prefHeight="66"
                                       styleClass="role-desc"/>
                                <HBox alignment="CENTER" spacing="12"
                                      styleClass="role-pill,role-pill-secretary">
                                    <Label text="Register" styleClass="role-pill-text"/>
                                    <Label text="&#8594;" styleClass="role-pill-text"/>
                                </HBox>
                            </VBox>
                        </graphic>
                    </Button>

                    </FlowPane>

                    <Label text="Patient accounts are active right away.&#10;Doctor, nurse and secretary accounts are verified by an administrator before first sign-in."
                           textAlignment="CENTER"
                           styleClass="register-note"/>

                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?" styleClass="small-text"/>
                        <Button text="Login"
                                fx:id="loginButton"
                                onAction="#handleLogin"
                                styleClass="link-button"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="6" styleClass="footer">
            <padding>
                <Insets top="8" right="20" bottom="14" left="20"/>
            </padding>

            <HBox alignment="CENTER" spacing="14">
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
                <SVGPath content="M0 14 L16 14 L22 14 L27 3 L35 26 L41 14 L62 14" styleClass="ecg"/>
                <Region styleClass="footer-line" minWidth="150" prefWidth="150" maxWidth="150"/>
            </HBox>

            <Label text="TeleConsult Medical System" styleClass="footer-text"/>
        </VBox>
    </bottom>

</BorderPane>
