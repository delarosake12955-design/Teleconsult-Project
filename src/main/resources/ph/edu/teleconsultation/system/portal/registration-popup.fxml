<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="card"
      fx:controller="ph.edu.teleconsultation.system.portal.controller.RegistrationPopupController"
      stylesheets="@popup-theme.css"
      styleClass="popup-card"
      spacing="14"
      alignment="TOP_CENTER"
      prefWidth="480"
      minWidth="480"
      maxWidth="480"
      maxHeight="-Infinity">

    <StackPane fx:id="iconCircle"
               styleClass="popup-icon-circle,popup-icon-success">

        <Label fx:id="iconLabel"
               text="✓"
               styleClass="popup-icon"/>

    </StackPane>

    <Label fx:id="titleLabel"
           text="You're Registered!"
           styleClass="popup-title"/>

    <Label fx:id="messageLabel"
           text=""
           wrapText="true"
           textAlignment="CENTER"
           maxWidth="400"
           styleClass="popup-message"/>

    <VBox fx:id="stepsBox"
          spacing="12"
          maxWidth="400"
          styleClass="popup-steps">

        <HBox fx:id="stepOneRow"
              spacing="12"
              alignment="CENTER_LEFT"
              styleClass="popup-step-done">

            <StackPane styleClass="popup-step-number">
                <Label text="✓" styleClass="popup-step-number-text"/>
            </StackPane>

            <Label text="Registration received"
                   styleClass="popup-step-text"/>

        </HBox>

        <HBox fx:id="stepTwoRow"
              spacing="12"
              alignment="CENTER_LEFT"
              styleClass="popup-step-current">

            <StackPane styleClass="popup-step-number">
                <Label text="2" styleClass="popup-step-number-text"/>
            </StackPane>

            <Label text="An administrator verifies your details"
                   styleClass="popup-step-text"/>

        </HBox>

        <HBox fx:id="stepThreeRow"
              spacing="12"
              alignment="CENTER_LEFT">

            <StackPane styleClass="popup-step-number">
                <Label text="3" styleClass="popup-step-number-text"/>
            </StackPane>

            <Label fx:id="stepThreeLabel"
                   text="You can sign in once you are approved"
                   styleClass="popup-step-text"/>

        </HBox>

    </VBox>

    <HBox spacing="12"
          alignment="CENTER">

        <Button fx:id="closeButton"
                text="Stay Here"
                onAction="#handleClose"
                styleClass="popup-secondary-button"/>

        <Button fx:id="loginButton"
                text="Go to Login"
                onAction="#handleLogin"
                styleClass="popup-primary-button"/>

    </HBox>

</VBox>
