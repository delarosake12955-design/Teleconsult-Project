<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ph.edu.teleconsultation.system.portal.controller.SecretaryDashboardController"
            stylesheets="@secretary-dashboard.css, @teleconsult-theme.css, @notifications.css">

    <left>

        <VBox prefWidth="235"
              spacing="8"
              styleClass="sidebar">

            <padding>
                <Insets top="30"
                        right="20"
                        bottom="30"
                        left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="brand-container">

                <ImageView fitWidth="46" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@register-logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="1">
                    <HBox alignment="BOTTOM_LEFT">
                        <Label text="Tele" styleClass="logo-tele"/>
                        <Label text="Consult" styleClass="logo-consult"/>
                    </HBox>
                    <Label text="M E D I C A L   S Y S T E M" styleClass="sidebar-subtitle"/>
                </VBox>
            </HBox>

            <Label text="SECRETARY PORTAL"
                   styleClass="portal-label"/>

            <VBox spacing="6"
                  VBox.vgrow="ALWAYS">

                <Button text="Dashboard"
                        fx:id="dashboardButton"
                        onAction="#handleDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button-active"/>
                <StackPane styleClass="notification-row">

                    <Button text="Notifications"
                            fx:id="notificationsButton"
                            onAction="#handleNotifications"
                            maxWidth="Infinity"
                            styleClass="nav-button"/>

                    <Label fx:id="notificationBadge"
                           text="0"
                           visible="false"
                           managed="false"
                           mouseTransparent="true"
                           styleClass="notification-badge"
                           StackPane.alignment="CENTER_RIGHT"/>

                </StackPane>


                <Button text="Appointments"
                        fx:id="appointmentsButton"
                        onAction="#handleAppointments"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Verification Requests"
                        fx:id="verificationButton"
                        onAction="#handleVerificationRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Doctors"
                        fx:id="doctorsButton"
                        onAction="#handleDoctors"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Patients"
                        fx:id="patientsButton"
                        onAction="#handlePatients"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="Profile"
                        fx:id="profileButton"
                        onAction="#handleProfile"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

            </VBox>

            <Button text="Logout"
                    fx:id="logoutButton"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    styleClass="logout-button"/>

        </VBox>

    </left>

    <center>

        <StackPane fx:id="contentHost" styleClass="content-host">

            <ScrollPane fx:id="dashboardContent" fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="25"
                  styleClass="main-content">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS">

                        <Label text="Good day,"
                               styleClass="greeting"/>

                        <Label fx:id="secretaryNameLabel"
                               text="Secretary"
                               styleClass="secretary-name"/>

                        <Label text="Manage appointments and administrative requests."
                               styleClass="description"/>

                    </VBox>

                    <VBox alignment="CENTER_RIGHT"
                          spacing="4"
                          styleClass="profile-mini-card">

                        <Label fx:id="profileNameLabel"
                               text="Secretary"
                               styleClass="profile-name"/>

                        <Label fx:id="departmentLabel"
                               text="Department"
                               styleClass="profile-role"/>

                    </VBox>

                </HBox>

                <HBox spacing="16">

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="8"
                          styleClass="stat-card">

                        <Label text="Appointments"
                               styleClass="stat-title"/>

                        <Label fx:id="appointmentCountLabel"
                               text="0"
                               styleClass="stat-number"/>

                        <Label text="Total appointments"
                               styleClass="stat-description"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="8"
                          styleClass="stat-card">

                        <Label text="Pending"
                               styleClass="stat-title"/>

                        <Label fx:id="pendingCountLabel"
                               text="0"
                               styleClass="stat-number"/>

                        <Label text="Appointments awaiting action"
                               styleClass="stat-description"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="8"
                          styleClass="stat-card">

                        <Label text="Verification"
                               styleClass="stat-title"/>

                        <Label fx:id="verificationCountLabel"
                               text="0"
                               styleClass="stat-number"/>

                        <Label text="Accounts awaiting review"
                               styleClass="stat-description"/>

                    </VBox>

                </HBox>

                <HBox spacing="18">

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="14"
                          styleClass="appointment-card">

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Appointment Management"
                                   styleClass="section-title"
                                   HBox.hgrow="ALWAYS"/>

                            <Button text="View All"
                                    fx:id="viewAppointmentsButton"
                                    onAction="#handleAppointments"
                                    styleClass="link-button"/>

                        </HBox>

                        <VBox spacing="10"
                              styleClass="appointment-row">

                            <HBox alignment="CENTER_LEFT">

                                <VBox spacing="4"
                                      HBox.hgrow="ALWAYS">

                                    <Label fx:id="appointmentPatientLabel"
                                           text="No pending appointments"
                                           styleClass="patient-name"/>

                                    <Label fx:id="appointmentDoctorLabel"
                                           text=""
                                           styleClass="appointment-details"/>

                                </VBox>

                                <Label fx:id="appointmentStatusLabel"
                                       text=""
                                       styleClass="status-label"/>

                            </HBox>

                        </VBox>

                    </VBox>

                    <VBox prefWidth="280"
                          spacing="14"
                          styleClass="verification-card">

                        <Label text="Verification Requests"
                               styleClass="section-title"/>

                        <Label fx:id="verificationSummaryLabel"
                               text="No pending verification requests."
                               wrapText="true"
                               styleClass="verification-text"/>

                        <Button text="Review Requests"
                                fx:id="reviewVerificationButton"
                                onAction="#handleVerificationRequests"
                                styleClass="primary-button"/>

                    </VBox>

                </HBox>

                <Label text="Quick Access"
                       styleClass="section-title"/>

                <HBox spacing="16">

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="8"
                          styleClass="quick-card">

                        <Label text="Appointments"
                               styleClass="quick-title"/>

                        <Label text="Review and manage scheduled appointments."
                               wrapText="true"
                               styleClass="quick-description"/>

                        <Button text="Manage Appointments"
                                fx:id="quickAppointmentsButton"
                                onAction="#handleAppointments"
                                styleClass="card-button"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="8"
                          styleClass="quick-card">

                        <Label text="Verification"
                               styleClass="quick-title"/>

                        <Label text="Review account verification requests."
                               wrapText="true"
                               styleClass="quick-description"/>

                        <Button text="View Requests"
                                fx:id="quickVerificationButton"
                                onAction="#handleVerificationRequests"
                                styleClass="card-button"/>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS"
                          spacing="8"
                          styleClass="quick-card">

                        <Label text="Doctors"
                               styleClass="quick-title"/>

                        <Label text="View registered doctors."
                               wrapText="true"
                               styleClass="quick-description"/>

                        <Button text="View Doctors"
                                fx:id="quickDoctorsButton"
                                onAction="#handleDoctors"
                                styleClass="card-button"/>

                    </VBox>

                </HBox>

            </VBox>

            </ScrollPane>

        </StackPane>

    </center>

</BorderPane>