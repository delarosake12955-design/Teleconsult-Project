<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ph.edu.teleconsultation.system.portal.controller.VisitCompletedController"
      stylesheets="@popup-theme.css"
      styleClass="visit-card"
      prefWidth="480" minWidth="480" maxWidth="480"
      maxHeight="-Infinity">

    <!-- no header band: a big animated check says "done" -->
    <VBox alignment="CENTER" spacing="10" styleClass="done-top">
        <StackPane fx:id="badge" styleClass="done-badge">
            <Label text="&#10003;" styleClass="done-check"/>
        </StackPane>
        <Label fx:id="titleLabel" text="Visit completed" styleClass="done-title"/>
        <Label fx:id="subtitleLabel" text="" wrapText="true" styleClass="done-subtitle"/>
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="220" styleClass="visit-scroll">
        <VBox fx:id="rows" styleClass="visit-body" spacing="8"/>
    </ScrollPane>

    <VBox styleClass="visit-footer" spacing="12">
        <Label fx:id="noteLabel" wrapText="true" maxWidth="420" styleClass="visit-hint"/>
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="okButton" text="Done" onAction="#handleClose" styleClass="popup-primary-button"/>
        </HBox>
    </VBox>
</VBox>
